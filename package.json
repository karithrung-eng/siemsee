{
  "name": "siemsee",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "build:artifact": "npm run build:single && node scripts/build-artifact.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  }
}
